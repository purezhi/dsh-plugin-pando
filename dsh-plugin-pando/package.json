{
  "name": "@purezhi/dsh-plugin-pando",
  "version": "1.1.0",
  "description": "Pando desktop pet for the DSH UI: a replica of the confirmo.love companion, with a local sprite directory and community sprites. Drag to move, right-click to switch sprite, click to interact.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "locale/*.json",
    "assets/**",
    "cordis.patch.yml",
    "README.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/purezhi/dsh-plugin-pando"
  },
  "license": "MIT",
  "icon": "./icon.svg"
}
